# ============================================================
#  红米 AX5 （标准版 / NAND，型号 RM1800）
#  上游源码：LiBwrt/LibWrt  分支：25.12-nss
#  目标平台：qualcommax / ipq60xx   架构：aarch64_cortex-a53 (64 位)
#  说明：本文件只写“关键项”，其余由工作流里的 make defconfig 自动补全
# ============================================================

# ---------- 1. 目标平台与设备（最关键，写错必失败） ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# 标准版红米 AX5（设备名 redmi_ax5）
# 已在 LiBwrt/LibWrt 的 25.12-nss 分支
#   target/linux/qualcommax/image/ipq60xx.mk 中核实到：define Device/redmi_ax5
# 写法与 KWRT 官方构建配置（config.buildinfo）逐字一致：
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5=y
# 注：该设备固件包 ipq-wifi-redmi_ax5 已由上游 ipq60xx.mk 的 DEVICE_PACKAGES 默认带上，
#     无需在此重复声明。

# 如果你的是【京东云版】AX5，请把上面那行换成下面这行（设备名不同）：
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

# ---------- 2. 系统基础 ----------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ---------- 3. Web 界面 / 中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- 4. 常用小插件（源码里若没有该包，defconfig 会自动丢弃，不会报错） ----------
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ============================================================
#  提示：
#  1) 想要作者 jolycqt373 那套完整插件（怕死wall / 去广告等），
#     建议把上游仓库自带的 configs/*.config 作为底稿，与本文件合并，
#     只保留上面第 1 节的设备行不要改。
#  2) AX5 内存只有 256M，插件别堆太多，否则会 OOM 掉线。
# ============================================================
